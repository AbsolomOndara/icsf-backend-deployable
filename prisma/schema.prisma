generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Managed by express-session/connect-pg-simple. Keeping it in the Prisma
// schema prevents `prisma db push` from treating active sessions as stray data.
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  COMPLETED
}

enum AssessmentType {
  QUIZ
  TEST
  EXAM
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  phone              String?
  passwordHash       String?
  role               UserRole             @default(STUDENT)
  status             UserStatus           @default(ACTIVE)
  mustChangePassword Boolean              @default(false)
  tutorProfile       TutorProfile?
  taughtCourses      CourseTutor[]
  enrollments        Enrollment[]         @relation("StudentEnrollments")
  approvals          Enrollment[]         @relation("EnrollmentApprover")
  progress           LessonProgress[]
  assessmentSubmissions AssessmentSubmission[]
  passwordTokens     PasswordSetupToken[]
  contactReplies     ContactMessage[]     @relation("ContactResponder")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model TutorProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  bio       String?
  expertise String?
  photoUrl  String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  price        Decimal       @default(0)
  imageUrl     String?
  duration     String?
  level        String?
  deliveryMode String        @default("Online and in-person")
  featured     Boolean       @default(false)
  status       CourseStatus  @default(DRAFT)
  tutors       CourseTutor[]
  modules      Module[]
  enrollments  Enrollment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CourseTutor {
  courseId   Int
  tutorId    Int
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor      User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@id([courseId, tutorId])
}

model Module {
  id       Int      @id @default(autoincrement())
  courseId Int
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  assessments Assessment[]

  @@unique([courseId, position])
}

model Lesson {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  title       String
  content     String?
  videoUrl    String?
  resourceUrl String?
  resourceTitle String?
  position    Int
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([moduleId, position])
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  studentId       Int
  courseId        Int
  status          EnrollmentStatus @default(PENDING)
  requestedAt     DateTime         @default(now())
  approvedAt      DateTime?
  approvedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?
  paymentReference String?
  paymentSubmittedAt DateTime?
  updatedAt       DateTime         @updatedAt
  student         User             @relation("StudentEnrollments", fields: [studentId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  approvedBy      User?            @relation("EnrollmentApprover", fields: [approvedById], references: [id])

  @@unique([studentId, courseId])
}

model LessonProgress {
  studentId   Int
  lessonId    Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
}

model Assessment {
  id              Int              @id @default(autoincrement())
  moduleId        Int
  title           String
  instructions    String?
  type            AssessmentType   @default(QUIZ)
  startsAt        DateTime?
  dueAt           DateTime?
  durationMinutes Int?
  maxScore        Int              @default(100)
  published       Boolean          @default(false)
  questions       Json
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions     AssessmentSubmission[]
  createdAt       DateTime         @default(now())
}

model AssessmentSubmission {
  id           Int              @id @default(autoincrement())
  assessmentId Int
  studentId    Int
  answers      Json?
  score        Decimal?
  feedback     String?
  status       SubmissionStatus @default(IN_PROGRESS)
  startedAt    DateTime         @default(now())
  submittedAt  DateTime?
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}

model EBook {
  id          Int       @id @default(autoincrement())
  title       String
  author      String?
  description String?
  category    String?
  coverUrl    String?
  fileUrl     String
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model PasswordSetupToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  status        String    @default("NEW")
  respondedAt   DateTime?
  respondedById Int?
  respondedBy   User?     @relation("ContactResponder", fields: [respondedById], references: [id])
  createdAt     DateTime  @default(now())
}
